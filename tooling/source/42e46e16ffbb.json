  "url": "https://apiweb.shoplinker.co.kr/ShoplinkerApi/ver3/_customer.html",
  "html": "\r\n\r\n<!DOCTYPE html>\r\n<html lang=\"ko\">\r\n<head>\r\n<meta charset=\"utf-8\">\r\n<meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge\">\r\n<meta name=\"apple-mobile-web-app-title\" content=\"Shoplinker\" />\r\n<meta name=\"keywords\" content=\"쇼핑몰, 호스팅, 컬러샵, 샵링커, 연동솔루션\">\r\n<meta name=\"description\" content=\"대한민국 최고의 쇼핑몰 솔루션은 오직 샵링커뿐입니다!\">\r\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1.0,minimum-scale=1.0,maximum-scale=1.0,user-scaleable=no\" />\r\n<title>Shoplinker API - 샵링커 API</title>\r\n<!--link rel=\"shortcut icon\" href=\"../images/ico/favicon.ico\"-->\r\n<link rel=\"stylesheet\" href=\"./css/reset.css\" />\r\n<link rel=\"stylesheet\" href=\"./css/jquery.fullPage.css\" /> <!--풀페이지에만 적용-->\r\n<link rel=\"stylesheet\" href=\"./css/content.css\" />\r\n<script src=\"./js/jquery-1.8.1.min.js\" type=\"text/javascript\"></script>\r\n<script src=\"./js/jquery.color-2.1.2.min.js\" type=\"text/javascript\"></script>\r\n<script src=\"./js/jquery.fullPage.min.js\" type=\"text/javascript\"></script>\r\n<script src=\"./js/common.js\" type=\"text/javascript\"></script>\r\n<script src=\"/ShoplinkerApi/ver3/js/main.js\" type=\"text/javascript\"></script>\r\n\r\n<script type=\"text/javascript\">\r\njQuery(document).ready(function() {\r\n\t$(\"#nemo\").find(\"input[id='password']\").keydown(function(key){\r\n\t\tif (key.keyCode == 13) {\r\n\t\t\tacheck();\r\n\t\t\treturn false;\r\n\t\t}\r\n\t});\r\n});\r\n\r\nfunction acheck()\r\n{\r\n\tif( $(\"#user_id\").val() == \"\" )\r\n\t{\r\n\t\talert(\"아이디를 입력해주시기 바랍니다\");\r\n\t\tdocument.nemo.user_id.focus();\r\n\t\treturn 0;\r\n\t}\r\n\telse if( $(\"#password\").val() == \"\" )\r\n\t{\r\n\t\talert(\"패스워드를 입력해주시기 바랍니다\");\r\n\t\tdocument.nemo.c_password.focus();\r\n\t\treturn;\r\n\t}\r\n\telse\r\n\t{\r\n\t\tvar postData = $(\"#nemo\").serialize();\r\n\t\t$.post(\r\n\t\t\t\"./login.html\",\r\n\t\t\t{\r\n\t\t\t\tpostData:postData\r\n\t\t\t},\r\n\t\t\tfunction(jsonData) {\r\n\t\t\t\tvar returnData\t\t= eval(\"(\" + jsonData + \")\");\r\n\t\t\t\tvar success = returnData.success;\r\n\t\t\t\t//alert(success);\r\n\t\t\t\tif( success == true )\r\n\t\t\t\t{\r\n\t\t\t\t\t//alert(returnData.msg);\r\n//\t\t\t\t\tvar return_url = $(\"#return_url\").val();\r\n\t\t\t\t\tvar return_url =returnData.return_url;\r\n\t\t\t\t\t//var msg = \"\";\r\n\t\t\t\t\tif( return_url == \"\"  )\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\t//alert('return');\r\n\t\t\t\t\t\t//window.location.replace(\"http://apiweb.shoplinker.co.kr/ShoplinkerApi/ver3/index.html\");\r\n\t\t\t\t\t\t\t//location.href=\"/\";\r\n\t\t\t\t\t}\r\n\t\t\t\t\telse\r\n\t\t\t\t\t{\r\n\t\t\t\t\t\twindow.location.replace(return_url);\r\n\t\t\t\t\t}\r\n\t\t\t\t}\r\n\t\t\t\telse\r\n\t\t\t\t{\r\n\t\t\t\t\talert(returnData.msg);\r\n\t\t\t\t}\r\n\t\t\t}\r\n\t\t);\r\n\t\t}\r\n\t//alert('end');\r\n}\r\n\r\nfunction logOut()\r\n{\r\n\t$.post(\r\n\t\t\"./login.html\",\r\n\t\t{\r\n\t\t\tmode:\"logout\"\r\n\t\t},\r\n\t\tfunction(jsonData) {\r\n\t\t\tlocation.href='./index.html';\r\n\t\t}\r\n\t);\r\n\r\n}\r\n</script>\r\n\r\n\r\n<!--풀페이지에만 적용-->\r\n<script type=\"text/javascript\">\r\n    $(function(){\r\n        $('#fullpage2').fullpage({\r\n            anchors: ['0rdPage', '1rdPage', '2rdPage', '3rdPage', '4rdPage', '5rdPage', '6rdPage', '7rdPage', '8rdPage', '9rdPage', '10rdPage', '11rdPage', '12rdPage', '13rdPage', '14rdPage', '15rdPage', '16rdPage', '17rdPage'],\r\n            menu: '#menu2',\r\n            easingcss3: 'cubic-bezier(0.175, 0.885, 0.320, 1.275)',\r\n            loopTop: true,\r\n            loopBottom: true\r\n        });\r\n    });\r\n</script>\r\n<!--//풀페이지에만 적용-->\r\n\r\n<!--[if lt IE 9]>\r\n<script src=\"./js/respond.min.js\"></script>\r\n<![endif]-->\r\n</head>\r\n<body>\r\n<!-- skip navigation -->\r\n<div id=\"skip\">\r\n    <a href=\"#gnb\"><span>대메뉴 바로가기</span></a>\r\n    <a href=\"#content\"><span>컨텐츠 바로가기</span></a>\r\n</div>\r\n<!-- //skip navigation -->\r\n<div class=\"wrap customer\">\r\n\r\n\t<!--header-->\r\n\t<div class=\"header\">\r\n\t\t<h1 class=\"logo\">SH<span>O</span>P<br>LINKER<br>-API</h1>\r\n\t\t<div class=\"gnb\">\r\n\t\t\t<ul id=\"gnb\">\r\n\t\t\t\t<li>\r\n\t\t\t\t\t<span class=\"ico-home\"></span>\r\n\t\t\t\t\t<a href=\"/ShoplinkerApi/ver3/index.html?type_gubun=001\"><span>Home</span></a>\r\n\t\t\t\t</li>\r\n\t\t\t\t<li class=\"ov\">\r\n\t\t\t\t\t<span class=\"ico-api\"></span>\r\n\t\t\t\t\t<a href=\"/ShoplinkerApi/ver3/_customer.html?type_gubun=002\"> \t\t\t\t\t<span>API</span></a>\r\n\t\t\t\t</li>\r\n\t\t\t\t<li>\r\n\t\t\t\t\t<span class=\"ico-sandbox\"></span>\r\n\t\t\t\t\t<a href=\"#\" class=\"login-btn\"> \t\t\t\t\t<span>sandBox</span></a>\r\n\t\t\t\t</li>\r\n\t\t\t\t<li>\r\n\t\t\t\t\t<span class=\"ico-service\"></span>\r\n\t\t\t\t\t<a href=\"/ShoplinkerApi/ver3/introduce.html?type_gubun=004\"><span>API소개</span></a>\r\n\t\t\t\t</li>\r\n\t\t\t\t<li>\r\n\t\t\t\t\t<span class=\"ico-key\"></span>\r\n\t\t\t\t\t<a href=\"#\"  class=\"login-btn\"> \t\t\t\t\t<span>업체설정</span></a>\r\n\t\t\t\t</li>\r\n\t\t\t</ul>\r\n\t\t\t<div class=\"bn-logout\">\r\n\t\t\t\t<span class=\"ico-logout\"></span>\r\n\t\t\t\t<a href=\"#\" onclick=\"javascript:logOut();\">logout</a>\r\n\t\t\t</div>\r\n\t\t</div>\r\n\r\n\t</div>\r\n\t<!--//header-->\r\n\r\n\t<!--content-->\r\n\t<div id=\"content\">\r\n\r\n\r\n\r\n\t\t<div class=\"submenu-wrap\">\r\n\t\t\t<div class=\"submenu\">\r\n\t\t\t\t<ul class=\"menu-title\">\r\n\t\t\t\t\t<li class=\"ov\"><a href=\"http://apiweb.shoplinker.co.kr/ShoplinkerApi/ver3/_customer.html\">API-view</a></li>\r\n\t\t\t\t\t<li>\r\n\t\t\t\t\t\t<a href=\"#\" class=\"login-btn\">\t\t\t\t\t\tAPI-Dev</a>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ul>\r\n\t\t\t\t<ol id=\"menu2\">\r\n\t\t\t\t\t<li>샵링커 상품관리\r\n\t\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"0rdPage\"><a href=\"#0rdPage\">- 상품 등록/수정</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"1rdPage\"><a href=\"#1rdPage\">- 샵링커 상품조회</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"2rdPage\"><a href=\"#2rdPage\">- 쇼핑몰 판매가등록</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"3rdPage\"><a href=\"#3rdPage\">- 품목정보 등록/수정</a></li>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t\t<li>쇼핑몰 연동 상품관리\r\n\t\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"4rdPage\"><a href=\"#4rdPage\">- 쇼핑몰 상품등록</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"5rdPage\"><a href=\"#5rdPage\">- 쇼핑몰 상품수정</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"6rdPage\"><a href=\"#6rdPage\">- 쇼핑몰 상품조회</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"7rdPage\"><a href=\"#7rdPage\">- 쇼핑몰 기간연장</a></li>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t\t<li>주문관리\r\n\t\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"8rdPage\"><a href=\"#8rdPage\">- 주문수집</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"9rdPage\"><a href=\"#9rdPage\">- 샵링커 송장등록</a></li>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t\t<li>클레임/CS관리\r\n\t\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"10rdPage\"><a href=\"#10rdPage\">- 클레임 수집</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"11rdPage\"><a href=\"#11rdPage\">- CS수집</a></li>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t\t<li>공지사항 수집\r\n\t\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"12rdPage\"><a href=\"#12rdPage\">- 공지사항 수집</a></li>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t\t<li>카테고리 정보\r\n\t\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"13rdPage\"><a href=\"#13rdPage\">- 카테고리 조회</a></li>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t\t<li>관리자 부가기능\r\n\t\t\t\t\t\t<ul>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"14rdPage\"><a href=\"#14rdPage\">- 샵링커 그룹정보조회</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"15rdPage\"><a href=\"#15rdPage\">- 그룹정보 등록/수정</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"16rdPage\"><a href=\"#16rdPage\">- SCM로그인</a></li>\r\n\t\t\t\t\t\t\t<li data-menuanchor=\"17rdPage\"><a href=\"#17rdPage\">- 기본정보 조회</a></li>\r\n\t\t\t\t\t\t</ul>\r\n\t\t\t\t\t</li>\r\n\t\t\t\t</ol>\r\n\r\n\t\t\t</div>\r\n\t\t</div>\r\n\r\n\t\t<div id=\"fullpage2\">\r\n\r\n\t\t\t<div class=\"section\" id=\"section0\">\r\n\t\t\t\t<div class=\"custom-sec custom-0\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">상품 등록/수정</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">Shoplinker와 자사몰 간의 “고객 API” 를 진행 하시면 너무나 익숙한 “자사몰” 에 등록 한 상품들을...<br>이제 shoplinker 로 원하는 상품을 원하는 시간에 원하는 만큼 한 번에 보낼 수 있습니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer0.jpg\" alt=\"자사몰 - 샵링커\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">자동 수동 전송</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section1\">\r\n\t\t\t\t<div class=\"custom-sec custom-1\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">샵링커 상품조회</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">샵링커에 로그인 할 필요 없이 샵링커 에 등록(전송)한 상품 을 조회 할 수 있습니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer1.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">샵링커 가입코드, 시작날짜, 마지막날짜</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">판매상태 , 가격 , 원산지 등등</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section2\">\r\n\t\t\t\t<div class=\"custom-sec custom-2\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">쇼핑몰 판매가등록</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">샵링커 는 판매처(쇼핑몰) 별 수수료 , 판매가 , 공급가 가 등을 쉽고 빠르게 적용 할 수 있습니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer2.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">쇼핑몰명 , 시중가 , 판매가  마진율 등등</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">등록 성공 or 실패 결과값</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section3\">\r\n\t\t\t\t<div class=\"custom-sec custom-3\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">품목정보 등록/수정</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">37가지 품목정보(상품 정보제공고 시)도 샵링커 등록 상품 에 쉽게 적용 할수 있습니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer3.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">쇼핑몰명 , 시중가 , 판매가  마진율 등등</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">등록 성공 or 실패 결과값</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section4\">\r\n\t\t\t\t<div class=\"custom-sec custom-4_2\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">쇼핑몰 상품등록</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">샵링커에 등록된 상품을  한번에 여러 쇼핑몰에 상품등록 할 수 있습니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer2_1.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">샵링커 상품코드, 쇼핑몰계정, 쇼핑몰코드 등등</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section5\">\r\n\t\t\t\t<div class=\"custom-sec custom-4\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">쇼핑몰 상품수정</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">자사몰 의 상품 정보를(가격 / 판매상태 등) 변경 하면 원하시는 판매처(쇼핑몰)에<br>원하시는 상품 만 실시간 바로바로 자사몰 과 동일 하게 변경 됩니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer4.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section6\">\r\n\t\t\t\t<div class=\"custom-sec custom-5\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">쇼핑몰 상품조회</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">샵링커를 통하여 연동 하신 쇼핑몰(판매처) 상품도 한번에 조회가 가능합니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer5.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">샵링커 가입코드, 시작 날짜  마지막 날짜</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">쇼핑몰 상품연동 내역</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section7\">\r\n\t\t\t\t<div class=\"custom-sec custom-6\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">쇼핑몰 기간연장</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">ESM(옥션, 지마켓) 의 판매기간 연장을 고객 API 로 편하게 진행 하실수 있습니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer6.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt-s\">Shoplinker 주문리스트에 송장등록</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section8\">\r\n\t\t\t\t<div class=\"custom-sec custom-7\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">주문수집</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">샵링커에 자동으로 수집 된 주문리스트를 빠르고 정확하게 자사몰로...</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer7.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">샵링커 가입코드, 쇼핑몰 코드</p>\r\n\t\t\t\t\t<p class=\"custom-txt-s\">주문 수집 스케줄링 설정</p>\r\n\t\t\t\t\t<p class=\"custom-txt3\">쇼핑몰 주문리스트</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section9\">\r\n\t\t\t\t<div class=\"custom-sec custom-8\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">샵링커 송장등록</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">자사몰 에서 직접 송장번호 를 입력 하면 판매처(쇼핑몰)<br>구매 고객에게 송장번호 일괄 전송 이 가능 합니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer8.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">Shoplinker 주문리스트에 송장등록</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section10\">\r\n\t\t\t\t<div class=\"custom-sec custom-10\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">클레임 수집</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">수집 후 처리 가능 여부 체크 (샵링커 까지 전송 )</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer10.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">클레임 시작 클레임 종료 날짜</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">클레임 상태, 종류, 메모, 날짜 등 내역</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section11\">\r\n\t\t\t\t<div class=\"custom-sec custom-11\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">CS수집</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">수집 후 처리 가능 여부 체크 (샵링커까지 전송)</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer11.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">C/S 시작 C/S종료 날짜</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">C/S 제목, 사유, 처리상태 내역</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section12\">\r\n\t\t\t\t<div class=\"custom-sec custom-12\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">공지사항 수집</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">판매처(쇼핑몰) 의 공지사항을 자사몰 에서 확인 할수 있습니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer12.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">게시판종류 , 공지사항 날짜</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">공지사항 제목, 내용, 조회수 등</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section13\">\r\n\t\t\t\t<div class=\"custom-sec custom-13\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">카테고리 조회</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">카테고리조회 api 타입정보에 따라 카테고리 정보 조회가 가능합니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer2_5.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">고객사코드, 타입정보</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">카테고리 정보</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section14\">\r\n\t\t\t\t<div class=\"custom-sec custom-14\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">샵링커 그룹정보조회</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">그룹정보조회 api를  통하여 그룹정보(그룹명, 그룹id등) 조회가  가능합니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer2_6.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">고객사코드 쇼핑몰계정 쇼핑몰코드 등등</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">그룹 정보(그룹명, 그룹id등</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section15\">\r\n\t\t\t\t<div class=\"custom-sec custom-15\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">그룹정보 등록/수정</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">그룹등록 api 를 통하여  샵링커 그룹정보 등록페이지로 이동됩니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer2_3.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">고객사코드, 쇼핑몰계정, 쇼핑몰코드</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section16\">\r\n\t\t\t\t<div class=\"custom-sec custom-16\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">SCM로그인</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">Scm 로그인 api를  통하여 직접 접속 가능합니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer2_2.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">고객사코드, 쇼핑몰계정, 쇼핑몰코드</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t\t<div class=\"section\" id=\"section17\">\r\n\t\t\t\t<div class=\"custom-sec custom-17\">\r\n\t\t\t\t\t<h2 class=\"custom-title\">기본정보 조회</h2>\r\n\t\t\t\t\t<p class=\"custom-txt\">기본정보 api 타입정보에 따라 정보 조회가 가능합니다.</p>\r\n\t\t\t\t\t<img src=\"images/customer/img_customer2_4.jpg\" alt=\"\"/>\r\n\t\t\t\t\t<p class=\"custom-txt1\">고객사코드, 타입정보</p>\r\n\t\t\t\t\t<p class=\"custom-txt2\">원산지, 택배사 리스트, 쇼핑몰리스트, 품목고시리스트</p>\r\n\t\t\t\t\t<div class=\"mgt_30\">\r\n\t\t\t\t\t\t\t\t\t\t</div>\r\n\t\t\t\t</div>\r\n\t\t\t</div>\r\n\r\n\t\t</div>\r\n\r\n\t</div>\r\n\t<!--//content-->\r\n\r\n</div>\r\n\r\n<!------------------------------------------------------------------------------->\r\n<div class=\"modalpop login-modal\">\r\n    <h2 class=\"modal-title\"><span>로그인</span></h2>\r\n\t\t\t<form method=\"post\" name=\"nemo\" id=\"nemo\" >\r\n\t\t\t<input name=\"return_url\" id=\"return_url\" type=\"hidden\" value=\"\">\r\n\t\t\t<input name=\"mode\" id=\"mode\" type=\"hidden\" value=\"login\">\r\n        <fieldset>\r\n        <legend>로그인</legend>\r\n        <div class=\"login-bx\">\r\n            <p><label><span class=\"label-hid\">회원아이디</span> <input type=\"text\" name=\"user_id\" id=\"user_id\" value=\"\"></label></p>\r\n            <p class=\"login-pass\"><label><span class=\"label-hid\">비밀번호</span> <input type=\"password\" name=\"password\" id=\"password\"></label></p>\r\n            <div class=\"id-check\"><label><input type=\"checkbox\" name=\"idSave\" id=\"idSave\" value=\"on\" > 아이디 저장하기</label></div>\r\n            <input class=\"login-submit\" id = \"\" name =\"\" type=\"button\" onclick=\"acheck();\"  value=\"로그인\">\r\n\r\n\r\n            <div class=\"login-bnlist\">\r\n                <a href=\"#\" class=\"bn2\">회원가입</a>\r\n                <a href=\"#\" class=\"bn2\">아이디/비밀번호 찾기</a>\r\n            </div>\r\n\r\n        </div>\r\n        </fieldset>\r\n    </form>\r\n\r\n    <div class=\"bn-close\"><button type=\"button\"><span>닫기</span></button></div>\r\n</div>\r\n\r\n<!------------------------------------------------------------------------------->\r\n\r\n</body>\r\n</html>",
